    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Images with vulnerability findings. Each image digest counts once per namespace. Open Trivy Insights for CVE and package details. Matches the severity and counting rules above.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "minWidth": 70
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Critical": {
                        "color": "red",
                        "text": "Critical"
                      },
                      "High": {
                        "color": "orange",
                        "text": "High"
                      },
                      "Medium": {
                        "color": "yellow",
                        "text": "Medium"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "x": 0,
