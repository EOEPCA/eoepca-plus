              "namespace": "Namespace",
              "resource_kind": "Kind",
              "resource_name": "Resource",
              "name": "Report",
              "image_registry": "Registry",
              "image_repository": "Image",
              "image_tag": "Tag",
              "image_digest": "Digest",
              "severity": "Severity",
              "Value": "Findings"
            },
            "indexByName": {
              "image_repository": 0,
              "namespace": 1,
              "severity": 2,
              "Value": 3,
              "image_digest": 4
            }
          }
        },
        {
