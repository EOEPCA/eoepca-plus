          "expr": "sum by(component) (rate(controller_runtime_reconcile_total{job=\"crossplane-metrics\",component!=\"crossplane-core\",component=~\"${provider:regex}\",controller=~\"managed/.*|bucket[.]minio[.]crossplane[.]io|policy[.]minio[.]crossplane[.]io|user[.]minio[.]crossplane[.]io\"}[5m])) * 60",
