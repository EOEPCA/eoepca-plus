          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by(le) (rate(controller_runtime_reconcile_time_seconds_bucket{job=\"crossplane-metrics\",controller=\"composite/storages.pkg.internal\"}[5m])))",
          "legendFormat": "Storage",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Providers — reconciliations / min",
      "description": "Managed resource reconciliations grouped by provider. The Provider filter applies to provider charts. CRD gate controllers are excluded.",
