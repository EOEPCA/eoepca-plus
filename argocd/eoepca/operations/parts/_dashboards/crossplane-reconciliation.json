          "editorMode": "code",
          "expr": "sum(increase(controller_runtime_reconcile_errors_total{job=\"crossplane-metrics\",component=~\"crossplane-core|${provider:regex}\",controller=~\"composite/.*|managed/.*|bucket[.]minio[.]crossplane[.]io|policy[.]minio[.]crossplane[.]io|user[.]minio[.]crossplane[.]io\"}[$__range]))",
