                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "${datasource}"
                    },
                    "expr": "sum(rate(container_cpu_usage_seconds_total{job=\"kubelet\", metrics_path=\"/metrics/cadvisor\", cluster=\"$cluster\", node=~\"$node\", container!=\"\", image!=\"\"}[$__rate_interval])) by (namespace, pod)",
                    "legendFormat": "{{namespace}} / {{pod}}",
                    "refId": "C"
                }
            ],
            "title": "CPU by pod",
            "type": "timeseries"
        },
