                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "max allocatable"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "super-light-red",
                                    "mode": "fixed"
                                }
                            },
                            {
                                "id": "custom.stacking",
                                "value": {
                                    "mode": "none"
                                }
                            },
                            {
                                "id": "custom.hideFrom",
                                "value": {
                                    "legend": false,
                                    "tooltip": true,
                                    "viz": false
                                }
