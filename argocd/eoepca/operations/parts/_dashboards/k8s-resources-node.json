                        }
                    },
                    "unit": "cores"
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "max capacity"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "red",
                                    "mode": "fixed"
                                }
                            },
                            {
                                "id": "custom.stacking",
                                "value": {
                                    "mode": "none"
                                }
                            },
                            {
                                "id": "custom.hideFrom",
                                "value": {
                                    "legend": false,
                                    "tooltip": true,
