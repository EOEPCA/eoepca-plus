  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Failed Kyverno evaluations observed during the selected time range and namespace selection. Repeated admission requests and background scans are counted; this is not the number of currently non-compliant resources.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "orange", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(kyverno_policy_results_total{resource_namespace=~\"$namespace\",rule_result=\"fail\"}[$__range])) or vector(0)",
          "instant": true,
          "legendFormat": "Failures",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Failed policy evaluations",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Skipped evaluations caused by match exclusions, preconditions, or PolicyExceptions. This is activity, not an inventory of declared exceptions.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "blue", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(kyverno_policy_results_total{resource_namespace=~\"$namespace\",rule_result=\"skip\"}[$__range])) or vector(0)",
          "instant": true,
          "legendFormat": "Skipped",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Skipped policy evaluations",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Policy engine errors for the selected namespace require controller or policy investigation.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(kyverno_policy_results_total{resource_namespace=~\"$namespace\",rule_result=\"error\"}[$__range])) or vector(0)",
          "instant": true,
          "legendFormat": "Errors",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Policy engine errors",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Kyverno evaluation activity by policy, rule, and result for the selected namespace. This shows execution rate rather than current compliance state.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}}, "overrides": []},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 5},
      "id": 4,
      "options": {
        "legend": {"calcs": ["sum"], "displayMode": "table", "placement": "right", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (policy_name, rule_name, rule_result) (rate(kyverno_policy_results_total{resource_namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{policy_name}} / {{rule_name}} / {{rule_result}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Policy evaluation rate",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["compliance"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {"selected": true, "text": "All", "value": "$__all"},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(kyverno_policy_results_total, resource_namespace)",
        "includeAll": true,
        "label": "Namespace",
        "multi": true,
        "name": "namespace",
        "options": [],
        "query": {"query": "label_values(kyverno_policy_results_total, resource_namespace)", "refId": "StandardVariableQuery"},
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-24h", "to": "now"},
