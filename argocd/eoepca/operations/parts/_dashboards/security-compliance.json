      "id": 25,
      "options": {"displayMode": "gradient", "legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "maxVizHeight": 300, "minVizHeight": 16, "minVizWidth": 8, "namePlacement": "auto", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showUnfilled": true, "sizing": "auto", "valueMode": "color"},
      "targets": [{"editorMode": "code", "expr": "sum by (title) (trivy_cluster_compliance{status=\"Fail\"})", "instant": true, "legendFormat": "{{title}}", "range": false, "refId": "A"}],
