  "panels": [
    {
      "datasource": {"type": "grafana", "uid": "-- Grafana --"},
      "description": "This dashboard shows the latest stored security state for one or more selected namespaces. Kyverno stores policy outcomes in PolicyReports, and kube-state-metrics converts those reports and PolicyExceptions into Prometheus metrics. Trivy Operator provides finding totals, while kube-state-metrics provides report update times. The final row is cluster-wide and ignores the namespace filter. Native Kubernetes Pod Security Admission is not included because its metrics do not identify the evaluated namespace.",
      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "content": "## Current namespace security compliance\nShowing the latest stored results for **$namespace**. Start with violations and findings, then check freshness and coverage before deciding that a namespace is clean. Values refresh every 30 seconds; this view is not an archive of complete historical reports. The final row contains cluster-wide Trivy checks and does not use the namespace selection.",
        "mode": "markdown"
      },
      "pluginVersion": "12.4.2",
      "title": "How to read this dashboard",
      "type": "text"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 4},
      "id": 2,
      "panels": [],
      "title": "Current compliance state",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Number of failed policy-rule results currently stored by Kyverno for the selected namespace. This is a current snapshot, not a rate or a count of failures over time. One Kubernetes resource can fail several rules and therefore be counted more than once.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 5},
      "id": 3,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "sum(security_policyreport_result_info{namespace=~\"$namespace\",result=\"fail\"}) or vector(0)", "instant": true, "legendFormat": "Violations", "range": false, "refId": "A"}],
      "title": "Current policy violations",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Number of distinct Kyverno PolicyException objects whose match rules target the selected namespace. An exception is a declared waiver and does not mean that a matching violation currently exists. Use the table below to identify the exception, policy, namespace, and resource kind; inspect the PolicyException object for its complete match rules.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "blue", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 5},
      "id": 4,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "count(count by (exception, target_namespace) (security_policyexception_match_info{target_namespace=~\"$namespace\"})) or vector(0)", "instant": true, "legendFormat": "Exceptions", "range": false, "refId": "A"}],
      "title": "Declared exceptions",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Number of critical vulnerability occurrences in the available Trivy VulnerabilityReports for the selected namespace. The same vulnerability can be counted more than once when it occurs in different images or packages. Treat zero as clean only when report freshness and coverage are also healthy.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 5},
      "id": 5,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "sum(trivy_image_vulnerabilities{namespace=~\"$namespace\",severity=\"Critical\"}) or vector(0)", "instant": true, "legendFormat": "Critical", "range": false, "refId": "A"}],
      "title": "Critical image findings",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Number of high-severity vulnerability occurrences in the available Trivy VulnerabilityReports for the selected namespace. The value counts findings, not unique vulnerability IDs or affected images. Review report freshness and coverage before using it as the namespace total.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "orange", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 9},
      "id": 6,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "sum(trivy_image_vulnerabilities{namespace=~\"$namespace\",severity=\"High\"}) or vector(0)", "instant": true, "legendFormat": "High", "range": false, "refId": "A"}],
      "title": "High image findings",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Number of high or critical exposed-secret findings in the available Trivy reports for the selected namespace. Any non-zero value needs investigation because Trivy found secret-like content in a scanned image. A zero is reliable only when the secret reports are current and coverage is complete.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 9},
      "id": 7,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "sum(trivy_image_exposedsecrets{namespace=~\"$namespace\",severity=~\"Critical|High\"}) or vector(0)", "instant": true, "legendFormat": "Secrets", "range": false, "refId": "A"}],
      "title": "Exposed secrets",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Combined number of high or critical configuration findings and namespaced Role findings for the selected namespace. This counts individual findings rather than affected Kubernetes resources. ClusterRole findings are shown separately in the cluster-wide row because they cannot be assigned to one namespace.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "orange", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 9},
      "id": 8,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "(sum(trivy_resource_configaudits{namespace=~\"$namespace\",severity=~\"Critical|High\"}) or vector(0)) + (sum(trivy_role_rbacassessments{namespace=~\"$namespace\",severity=~\"Critical|High\"}) or vector(0))", "instant": true, "legendFormat": "Configuration and Role", "range": false, "refId": "A"}],
      "title": "Configuration and Role findings",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 13},
      "id": 9,
      "panels": [],
      "title": "Freshness and coverage",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Number of stored Kyverno policy-rule results older than 90 minutes. Kyverno normally runs a background scan every hour, and this panel allows another 30 minutes for processing. A non-zero value means the displayed policy state may no longer match the current resources; pass and skip results are included so a clean namespace still has a freshness check.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 14},
      "id": 10,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "sum((time() - security_policyreport_result_timestamp_seconds{namespace=~\"$namespace\"}) > bool 5400) or vector(0)", "instant": true, "legendFormat": "Stale", "range": false, "refId": "A"}],
      "title": "Stale policy results",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Number of Trivy VulnerabilityReports older than 26 hours for the selected namespace. The configured report lifetime is 24 hours, with a two-hour allowance for scanning and processing. A stale report means the scan evidence is old; it does not add another vulnerability finding.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 14},
      "id": 11,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "sum((time() - security_trivy_vulnerabilityreport_updated_timestamp_seconds{namespace=~\"$namespace\"}) > bool 93600) or vector(0)", "instant": true, "legendFormat": "Stale", "range": false, "refId": "A"}],
      "title": "Stale vulnerability reports",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Number of Trivy ExposedSecretReports older than 26 hours for the selected namespace. The configured report lifetime is 24 hours, with a two-hour allowance for scanning and processing. A stale report means the secret-scan result is old, not that a secret was found.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 14},
      "id": 12,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "sum((time() - security_trivy_exposedsecretreport_updated_timestamp_seconds{namespace=~\"$namespace\"}) > bool 93600) or vector(0)", "instant": true, "legendFormat": "Stale", "range": false, "refId": "A"}],
      "title": "Stale secret reports",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Current Kyverno PolicyReport results grouped as pass, fail, warning, error, or skip. Each value counts policy-rule results rather than Kubernetes resources. Pass results show that successful evaluations are being stored, while skip results should be compared with the declared exceptions and rule conditions.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": 0}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 18},
      "id": 13,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "sum by (result) (security_policyreport_result_info{namespace=~\"$namespace\"}) or vector(0)", "instant": true, "legendFormat": "{{result}}", "range": false, "refId": "A"}],
      "title": "Current policy outcomes",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Number of distinct containers currently present in Pods in the selected namespace. Compare this with the number of vulnerability report objects to spot possible scan gaps. The values are not expected to match exactly because Trivy also scans controller templates and CronJobs.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": 0}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 18},
      "id": 14,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "count(count by (namespace, pod, container) (kube_pod_container_info{namespace=~\"$namespace\"})) or vector(0)", "instant": true, "legendFormat": "Containers", "range": false, "refId": "A"}],
      "title": "Active Pod containers",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Number of distinct Trivy VulnerabilityReport objects represented in Prometheus for the selected namespace. One report does not always correspond to one active Pod container, so exact equality is not expected. A large gap from the active-container count needs investigation, and zero findings with poor coverage does not mean the namespace is clean.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": 0}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 18},
      "id": 15,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "count(security_trivy_vulnerabilityreport_updated_timestamp_seconds{namespace=~\"$namespace\"}) or vector(0)", "instant": true, "legendFormat": "Reports", "range": false, "refId": "A"}],
      "title": "Vulnerability report objects",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 22},
      "id": 16,
      "panels": [],
      "title": "Violations and exceptions",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Detailed list of current failed, warning, error, and skipped results from Kyverno PolicyReports in the selected namespace. Each row identifies the resource, policy, rule, severity, and outcome behind the summary numbers. A skip can be caused by an exception or another rule condition, so compare it with the exception table instead of assuming it is waived.",
      "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 9, "w": 14, "x": 0, "y": 23},
      "id": 17,
      "options": {"cellHeight": "sm", "footer": {"countRows": false, "fields": "", "reducer": ["sum"], "show": false}, "showHeader": true},
      "targets": [{"editorMode": "code", "expr": "security_policyreport_result_info{namespace=~\"$namespace\",result=~\"fail|warn|error|skip\"}", "format": "table", "instant": true, "legendFormat": "__auto", "range": false, "refId": "A"}],
      "title": "Current non-pass PolicyReport results",
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Summary of Kyverno PolicyException match branches that target the selected namespace. One exception can appear in several rows when it contains several match branches. The table shows the exception, policy, namespace, and resource kind, but not every selector; inspect the PolicyException object for its complete rules and remember that declaration does not prove current use.",
      "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}]}}, "overrides": []},
      "gridPos": {"h": 9, "w": 10, "x": 14, "y": 23},
      "id": 18,
      "options": {"cellHeight": "sm", "footer": {"countRows": false, "fields": "", "reducer": ["sum"], "show": false}, "showHeader": true},
      "targets": [{"editorMode": "code", "expr": "security_policyexception_match_info{target_namespace=~\"$namespace\"}", "format": "table", "instant": true, "legendFormat": "__auto", "range": false, "refId": "A"}],
      "title": "Declared PolicyExceptions",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 32},
