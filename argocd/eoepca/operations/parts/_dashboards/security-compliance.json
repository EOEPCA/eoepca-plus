    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Age in hours of every available Trivy report in the selected namespace. Vulnerability and exposed-secret reports should normally remain within their configured lifetime, while configuration and RBAC reports are updated when related resources change. Use the report and resource labels in this table to find the exact object behind a stale summary value; an old event-driven report is context, not automatically a failure.",
      "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false}, "decimals": 1, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "orange", "value": 26}]}, "unit": "h"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 43},
      "id": 23,
      "options": {"cellHeight": "sm", "footer": {"countRows": false, "fields": "", "reducer": ["max"], "show": false}, "showHeader": true},
      "targets": [{"editorMode": "code", "expr": "(time() - {__name__=~\"security_trivy_(vulnerability|configaudit|exposedsecret|rbacassessment)report_updated_timestamp_seconds\",namespace=~\"$namespace\"}) / 3600", "format": "table", "instant": true, "legendFormat": "__auto", "range": false, "refId": "A"}],
      "title": "Trivy report age by object",
