    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Age in hours of the oldest Trivy ClusterComplianceReport. Reports are scheduled every six hours: green is at most seven hours old, orange indicates one delayed or missed update, and red indicates more than two expected cycles without an update. An old value, or No data, indicates a scanner or reporting problem rather than an additional compliance failure.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "decimals": 1, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "orange", "value": 7}, {"color": "red", "value": 13}]}, "unit": "h"}, "overrides": []},
