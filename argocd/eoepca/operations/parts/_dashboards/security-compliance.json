      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Number of failed checks in each Trivy ClusterComplianceReport, grouped by compliance profile title. This shows failed CIS, NSA, or Pod Security controls across the whole cluster, not the number of failing namespaces or resources. These reports are cluster-scoped, so the namespace filter does not apply.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "orange", "value": 1}]}}, "overrides": []},
