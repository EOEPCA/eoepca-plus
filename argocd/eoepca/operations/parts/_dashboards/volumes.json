    {
      "id": 38,
      "title": "Node filesystems expected to fill first",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 18,
        "w": 8,
        "h": 6
      },
      "description": "Estimate from six hours of free-space samples, with at least five hours of data. No estimate is shown for stable or growing free space.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "bottomk(5, (node_filesystem_avail_bytes{fstype=~\"ext[234]|xfs|btrfs|zfs|bcachefs|vfat\",mountpoint!~\"/run.*|/var/lib/kubelet/pods/.+\"} / -(deriv((node_filesystem_avail_bytes{fstype=~\"ext[234]|xfs|btrfs|zfs|bcachefs|vfat\",mountpoint!~\"/run.*|/var/lib/kubelet/pods/.+\"})[6h:1m]))) and (deriv((node_filesystem_avail_bytes{fstype=~\"ext[234]|xfs|btrfs|zfs|bcachefs|vfat\",mountpoint!~\"/run.*|/var/lib/kubelet/pods/.+\"})[6h:1m]) < 0) and (count_over_time((node_filesystem_avail_bytes{fstype=~\"ext[234]|xfs|btrfs|zfs|bcachefs|vfat\",mountpoint!~\"/run.*|/var/lib/kubelet/pods/.+\"})[6h:1m]) >= 300))",
          "legendFormat": "{{instance}} {{mountpoint}}",
