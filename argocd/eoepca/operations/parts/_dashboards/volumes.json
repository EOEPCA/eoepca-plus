    {
      "id": 46,
      "title": "Longest pending snapshot",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 30,
        "w": 8,
        "h": 4
      },
      "description": "Age of the oldest pending request. The creation-stalled alert starts after 30 minutes, with a further 15-minute delay.",
