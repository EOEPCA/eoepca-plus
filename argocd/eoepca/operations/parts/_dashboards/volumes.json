          "expr": "(count(volumesnapshot:ready{namespace=~\"${snapshot_namespace:regex}\",driver=~\"${snapshot_driver:regex}\",snapshotclass=~\"${snapshot_class:regex}\"}) or (0 * volumesnapshot:inventory_available)) and on() volumesnapshot:inventory_available",
