        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(max(volumesnapshot:pending_age_seconds{namespace=~\"${snapshot_namespace:regex}\",driver=~\"${snapshot_driver:regex}\",snapshotclass=~\"${snapshot_class:regex}\"}) or (0 * volumesnapshot:inventory_available)) and on() volumesnapshot:inventory_available",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unavailable",
