    {
      "id": 6,
      "title": "Shared NFS capacity and growth",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 4
      },
      "description": "One summary per NFS server and shared storage area. Values apply to the shared filesystem, not to individual PVCs.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "label_join(nfs:capacity_bytes, \"filesystem\", \":\", \"nfs_server\", \"nfs_share\")",
          "legendFormat": "{{nfs_server}}:{{nfs_share}}",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "label_join(nfs:used_bytes, \"filesystem\", \":\", \"nfs_server\", \"nfs_share\")",
          "legendFormat": "{{nfs_server}}:{{nfs_share}}",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "label_join(nfs:available_bytes, \"filesystem\", \":\", \"nfs_server\", \"nfs_share\")",
          "legendFormat": "{{nfs_server}}:{{nfs_share}}",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "label_join(clamp_min(-nfs:available_bytes:deriv6h,0)*86400, \"filesystem\", \":\", \"nfs_server\", \"nfs_share\")",
          "legendFormat": "{{nfs_server}}:{{nfs_share}}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Capacity"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Used"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Available"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Growth per day"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "filesystem",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(filesystem|Value #[A-D])$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "filesystem": "NFS server / storage area",
              "Value #A": "Capacity",
              "Value #B": "Used",
              "Value #C": "Available",
              "Value #D": "Growth per day"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
