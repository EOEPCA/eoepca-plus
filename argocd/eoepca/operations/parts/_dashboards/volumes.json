    {
      "id": 41,
      "title": "Snapshot monitoring",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 8,
        "h": 4
      },
      "description": "Collection health across the cluster. No snapshot API data means support has not been confirmed. Snapshot state does not report physical storage use.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "volumesnapshot:monitoring_state",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
