    {
      "id": 53,
      "title": "Snapshots needing attention",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 5
      },
      "description": "Only creation errors, requests pending for more than 30 minutes, and deletions older than one hour. Age starts at request creation, or at deletion for a delete operation.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "volumesnapshot:attention_required{namespace=~\"${snapshot_namespace:regex}\",driver=~\"${snapshot_driver:regex}\",snapshotclass=~\"${snapshot_class:regex}\"} and on() volumesnapshot:inventory_available",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
