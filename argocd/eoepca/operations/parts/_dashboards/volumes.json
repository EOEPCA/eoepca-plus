{
  "id": null,
  "uid": "eoepca-volumes",
  "title": "Kubernetes Volumes",
  "tags": [
    "baseline"
  ],
  "schemaVersion": 41,
  "version": 9,
  "editable": true,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "Keep events",
        "enable": true,
        "hide": false,
        "iconColor": "blue",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "expr": "{namespace=\"operations\",container=\"keep\"} | json | event_type=\"keep_alert_event\" | dashboard_uid=\"${__dashboard.uid}\"",
        "titleFormat": "{{alertname}}: {{status}}",
        "textFormat": "{{text}}",
        "tagKeys": "alertname,status",
        "maxLines": 100
      }
    ]
  },
  "links": [
    {
      "title": "Alerts in Keep",
      "type": "link",
      "icon": "external link",
      "url": "https://alerting.develop-v2.eoepca.org/alerts/feed",
      "targetBlank": true,
      "includeVars": false,
      "keepTime": false,
      "asDropdown": false,
      "tags": []
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "selected": true,
          "text": "Prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "namespace",
        "label": "Volume namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "query_result(count by(namespace) (volume:info and on(volumename) max by(volumename) (label_replace(kube_persistentvolume_info{nfs_server=\"\",csi_driver!~\"(?i).*(nfs|rclone|s3|smb|cifs|fuse|gcs|blob|cephfs|gluster).*\"}, \"volumename\", \"$1\", \"persistentvolume\", \"(.+)\"))))",
        "query": {
          "query": "query_result(count by(namespace) (volume:info and on(volumename) max by(volumename) (label_replace(kube_persistentvolume_info{nfs_server=\"\",csi_driver!~\"(?i).*(nfs|rclone|s3|smb|cifs|fuse|gcs|blob|cephfs|gluster).*\"}, \"volumename\", \"$1\", \"persistentvolume\", \"(.+)\"))))",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "regex": "/namespace=\"([^\"]+)\"/"
      },
      {
        "name": "storageclass",
        "label": "Volume storage class",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "query_result(count by(storageclass) (volume:info{namespace=~\"${namespace:regex}\"} and on(volumename) max by(volumename) (label_replace(kube_persistentvolume_info{nfs_server=\"\",csi_driver!~\"(?i).*(nfs|rclone|s3|smb|cifs|fuse|gcs|blob|cephfs|gluster).*\"}, \"volumename\", \"$1\", \"persistentvolume\", \"(.+)\"))))",
        "query": {
          "query": "query_result(count by(storageclass) (volume:info{namespace=~\"${namespace:regex}\"} and on(volumename) max by(volumename) (label_replace(kube_persistentvolume_info{nfs_server=\"\",csi_driver!~\"(?i).*(nfs|rclone|s3|smb|cifs|fuse|gcs|blob|cephfs|gluster).*\"}, \"volumename\", \"$1\", \"persistentvolume\", \"(.+)\"))))",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "regex": "/storageclass=\"([^\"]+)\"/"
      },
      {
        "name": "snapshot_namespace",
        "label": "Snapshot namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "query_result(count by(namespace) (volumesnapshot:info or volumesnapshot:content_info))",
        "query": {
          "query": "query_result(count by(namespace) (volumesnapshot:info or volumesnapshot:content_info))",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "regex": "/namespace=\"([^\"]+)\"/"
      },
      {
        "name": "snapshot_driver",
        "label": "Snapshot driver",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "query_result(count by(driver) (volumesnapshot:info{namespace=~\"${snapshot_namespace:regex}\"} or volumesnapshot:content_info{namespace=~\"${snapshot_namespace:regex}\"} or volumesnapshot:class_info))",
        "query": {
          "query": "query_result(count by(driver) (volumesnapshot:info{namespace=~\"${snapshot_namespace:regex}\"} or volumesnapshot:content_info{namespace=~\"${snapshot_namespace:regex}\"} or volumesnapshot:class_info))",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "regex": "/driver=\"([^\"]+)\"/"
      },
      {
        "name": "snapshot_class",
        "label": "Snapshot class",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "query_result(count by(snapshotclass) (volumesnapshot:info{namespace=~\"${snapshot_namespace:regex}\",driver=~\"${snapshot_driver:regex}\"} or volumesnapshot:content_info{namespace=~\"${snapshot_namespace:regex}\",driver=~\"${snapshot_driver:regex}\"} or volumesnapshot:class_info{driver=~\"${snapshot_driver:regex}\"}))",
        "query": {
          "query": "query_result(count by(snapshotclass) (volumesnapshot:info{namespace=~\"${snapshot_namespace:regex}\",driver=~\"${snapshot_driver:regex}\"} or volumesnapshot:content_info{namespace=~\"${snapshot_namespace:regex}\",driver=~\"${snapshot_driver:regex}\"} or volumesnapshot:class_info{driver=~\"${snapshot_driver:regex}\"}))",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "regex": "/snapshotclass=\"([^\"]+)\"/"
      }
    ]
  },
  "panels": [
    {
      "id": 5,
      "title": "Storage alerts firing",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count(ALERTS{alertstate=\"firing\",service=\"persistent-storage\"}) or vector(0)",
          "legendFormat": "{{namespace}} / {{persistentvolumeclaim}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Volumes at least 85% full",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "description": "Local and block-storage PVCs in the selected namespaces and storage classes. Shared NFS is shown in the overview below.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count((volume:free_ratio * on(namespace,persistentvolumeclaim) group_left(storageclass) (volume:info{namespace=~\"${namespace:regex}\",storageclass=~\"${storageclass:regex}\"} and on(volumename) max by(volumename) (label_replace(kube_persistentvolume_info{nfs_server=\"\",csi_driver!~\"(?i).*(nfs|rclone|s3|smb|cifs|fuse|gcs|blob|cephfs|gluster).*\"}, \"volumename\", \"$1\", \"persistentvolume\", \"(.+)\")))) < 0.15) or vector(0)",
          "legendFormat": "{{namespace}} / {{persistentvolumeclaim}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Volumes without capacity metrics",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "description": "Mounted local or block volumes with no capacity metrics. Their capacity alerts cannot run until collection works.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(sum by(namespace) (volume:stats_missing * on(namespace,persistentvolumeclaim) group_left(storageclass) (volume:info{namespace=~\"${namespace:regex}\",storageclass=~\"${storageclass:regex}\"} and on(volumename) max by(volumename) (label_replace(kube_persistentvolume_info{nfs_server=\"\",csi_driver!~\"(?i).*(nfs|rclone|s3|smb|cifs|fuse|gcs|blob|cephfs|gluster).*\"}, \"volumename\", \"$1\", \"persistentvolume\", \"(.+)\")))) or on(namespace) (0 * count by(namespace) ((volume:info{namespace=~\"${namespace:regex}\",storageclass=~\"${storageclass:regex}\"} and on(volumename) max by(volumename) (label_replace(kube_persistentvolume_info{nfs_server=\"\",csi_driver!~\"(?i).*(nfs|rclone|s3|smb|cifs|fuse|gcs|blob|cephfs|gluster).*\"}, \"volumename\", \"$1\", \"persistentvolume\", \"(.+)\")))))) or vector(0)",
          "legendFormat": "{{namespace}} / {{persistentvolumeclaim}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 52,
      "title": "Snapshots needing attention",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "description": "Current creation errors, requests pending for more than 30 minutes, and deletions older than one hour.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(count(volumesnapshot:attention_required{namespace=~\"${snapshot_namespace:regex}\",driver=~\"${snapshot_driver:regex}\",snapshotclass=~\"${snapshot_class:regex}\"}) or (0 * volumesnapshot:inventory_available)) and on() volumesnapshot:inventory_available",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 30,
      "title": "Volume capacity — local and block storage",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 31,
      "title": "Most used volume filesystems",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 6
      },
      "description": "The five most used volume filesystems in the selected namespaces and storage classes.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "topk(5, 1 - (volume:free_ratio * on(namespace,persistentvolumeclaim) group_left(storageclass) (volume:info{namespace=~\"${namespace:regex}\",storageclass=~\"${storageclass:regex}\"} and on(volumename) max by(volumename) (label_replace(kube_persistentvolume_info{nfs_server=\"\",csi_driver!~\"(?i).*(nfs|rclone|s3|smb|cifs|fuse|gcs|blob|cephfs|gluster).*\"}, \"volumename\", \"$1\", \"persistentvolume\", \"(.+)\")))))",
          "legendFormat": "{{namespace}} / {{persistentvolumeclaim}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 5,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 32,
      "title": "Volumes with the least free space",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 6
      },
      "description": "Free space available to each volume. Shared and virtual filesystem backends are excluded.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "bottomk(5, volume:available_bytes * on(namespace,persistentvolumeclaim) group_left(storageclass) (volume:info{namespace=~\"${namespace:regex}\",storageclass=~\"${storageclass:regex}\"} and on(volumename) max by(volumename) (label_replace(kube_persistentvolume_info{nfs_server=\"\",csi_driver!~\"(?i).*(nfs|rclone|s3|smb|cifs|fuse|gcs|blob|cephfs|gluster).*\"}, \"volumename\", \"$1\", \"persistentvolume\", \"(.+)\"))))",
          "legendFormat": "{{namespace}} / {{persistentvolumeclaim}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 5,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 34,
      "title": "Volumes expected to fill first",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 6
      },
      "description": "Estimated time to full from six hours of free-space samples. No estimate is shown for stable or growing free space, or incomplete history.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "bottomk(5, volume:seconds_until_full * on(namespace,persistentvolumeclaim) group_left(storageclass) (volume:info{namespace=~\"${namespace:regex}\",storageclass=~\"${storageclass:regex}\"} and on(volumename) max by(volumename) (label_replace(kube_persistentvolume_info{nfs_server=\"\",csi_driver!~\"(?i).*(nfs|rclone|s3|smb|cifs|fuse|gcs|blob|cephfs|gluster).*\"}, \"volumename\", \"$1\", \"persistentvolume\", \"(.+)\"))))",
          "legendFormat": "{{namespace}} / {{persistentvolumeclaim}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 5,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 35,
      "title": "Volumes with the fewest free inodes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 6
      },
      "description": "Free inode fraction. Filesystems can run out of inodes before they run out of bytes.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "bottomk(5, volume:inodes_free_ratio * on(namespace,persistentvolumeclaim) group_left(storageclass) (volume:info{namespace=~\"${namespace:regex}\",storageclass=~\"${storageclass:regex}\"} and on(volumename) max by(volumename) (label_replace(kube_persistentvolume_info{nfs_server=\"\",csi_driver!~\"(?i).*(nfs|rclone|s3|smb|cifs|fuse|gcs|blob|cephfs|gluster).*\"}, \"volumename\", \"$1\", \"persistentvolume\", \"(.+)\"))))",
          "legendFormat": "{{namespace}} / {{persistentvolumeclaim}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 5,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 23,
      "title": "Node filesystems — all nodes",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 13,
      "title": "Node filesystem usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 8,
        "h": 6
      },
      "description": "The five node filesystems with the highest disk use. Network and virtual filesystem mounts are excluded.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "topk(5, 1 - (node_filesystem_avail_bytes{fstype=~\"ext[234]|xfs|btrfs|zfs|bcachefs|vfat\",mountpoint!~\"/run.*|/var/lib/kubelet/pods/.+\"} / node_filesystem_size_bytes{fstype=~\"ext[234]|xfs|btrfs|zfs|bcachefs|vfat\",mountpoint!~\"/run.*|/var/lib/kubelet/pods/.+\"}))",
          "legendFormat": "{{instance}} {{mountpoint}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 5,
