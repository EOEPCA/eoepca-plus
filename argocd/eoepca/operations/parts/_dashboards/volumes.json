            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unavailable",
                  "color": "red"
                },
                "1": {
                  "text": "No snapshot API data",
                  "color": "yellow"
                },
                "2": {
                  "text": "Collecting",
                  "color": "green"
                }
              }
            }
          ]
